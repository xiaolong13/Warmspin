<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Warmspin"
        Width="1180" Height="760"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!-- 这些键会被 Theme.Apply 在运行时替换 -->
    <SolidColorBrush x:Key="B.Accent" Color="#E4393C"/>
    <SolidColorBrush x:Key="B.Accent2" Color="#FF6B6B"/>
    <LinearGradientBrush x:Key="B.AccentGrad" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF6B6B" Offset="0"/>
      <GradientStop Color="#E4393C" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.Bg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="B.SurfaceAlt" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="B.Border" Color="#E9EBEF"/>
    <SolidColorBrush x:Key="B.Text" Color="#16181D"/>
    <SolidColorBrush x:Key="B.TextDim" Color="#5B6472"/>
    <SolidColorBrush x:Key="B.TextMute" Color="#98A1B0"/>
    <SolidColorBrush x:Key="B.Ok" Color="#12B76A"/>
    <SolidColorBrush x:Key="B.Warn" Color="#F79009"/>
    <SolidColorBrush x:Key="B.Bad" Color="#F04438"/>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource B.Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource B.Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- 顶部标签 -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="9" Padding="18,9" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.SurfaceAlt}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentGrad}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 主按钮 -->
    <Style x:Key="BtnPrimary" TargetType="Button">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource B.AccentGrad}" Padding="20,11">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.SurfaceAlt}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 次按钮 -->
    <Style x:Key="BtnGhost" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="10" Background="{DynamicResource B.Surface}"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1" Padding="16,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.SurfaceAlt}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.TextMute}"/>
                <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource B.TextMute}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 预算分段 -->
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource B.TextDim}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="9" Padding="16,8" Margin="0,0,8,0"
                    Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource B.TextMute}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource B.AccentGrad}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 复选行 -->
    <Style x:Key="Chk" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource B.Text}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border x:Name="row" CornerRadius="10" Padding="14,11" Background="Transparent">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="26"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="box" Width="20" Height="20" CornerRadius="6"
                        BorderBrush="{DynamicResource B.Border}" BorderThickness="1.5"
                        Background="{DynamicResource B.Surface}" VerticalAlignment="Center">
                  <TextBlock x:Name="tick" Text="&#x2713;" FontSize="12" FontWeight="Bold"
                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource B.AccentGrad}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="Transparent"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="row" Property="Background" Value="{DynamicResource B.SurfaceAlt}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 进度条 -->
    <Style x:Key="PBar" TargetType="ProgressBar">
      <Setter Property="Height" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Border Background="{DynamicResource B.SurfaceAlt}" CornerRadius="5"
                    BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
              <Grid>
                <Border x:Name="PART_Track" CornerRadius="5" Background="{DynamicResource B.SurfaceAlt}"/>
                <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                        Background="{DynamicResource B.AccentGrad}"/>
              </Grid>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 滚动条 -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="9"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Width="9">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border Background="{DynamicResource B.Border}" CornerRadius="4" Margin="2,2"/>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                </Track.IncreaseRepeatButton>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                </Track.DecreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" CornerRadius="14" Background="{DynamicResource B.Bg}"
          BorderBrush="{DynamicResource B.Border}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.14" Color="#000000"/>
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="70"/>
        <RowDefinition Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== 顶栏 ===== -->
      <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource B.AccentGrad}">
            <Viewbox Margin="9">
              <Path Fill="White" Data="M13,1 L4,14 L11,14 L10,23 L20,9 L13,9 Z"/>
            </Viewbox>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Warmspin" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource B.Text}"/>
            <TextBlock Text="HDD GAME ACCELERATOR" FontSize="8.5" Foreground="{DynamicResource B.TextMute}" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
          <Button x:Name="BtnTheme" Width="40" Height="32" Background="Transparent" BorderThickness="0"
                  Cursor="Hand" ToolTip="切换主题">
            <StackPanel Orientation="Horizontal">
              <Border x:Name="ThemeDot" Width="12" Height="12" CornerRadius="6"
                      Background="{DynamicResource B.Accent}" VerticalAlignment="Center"/>
              <TextBlock Text="主题" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                         Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnMin" Width="38" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
            <TextBlock Text="&#x2500;" Foreground="{DynamicResource B.TextDim}" FontSize="12"/>
          </Button>
          <Button x:Name="BtnClose" Width="38" Height="32" Background="Transparent" BorderThickness="0" Cursor="Hand">
            <TextBlock Text="&#x2715;" Foreground="{DynamicResource B.TextDim}" FontSize="12"/>
          </Button>
        </StackPanel>
      </Grid>

      <!-- ===== 标签栏 ===== -->
      <Border Grid.Row="1" BorderBrush="{DynamicResource B.Border}" BorderThickness="0,1,0,1">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
          <RadioButton x:Name="TabOverview" Style="{StaticResource Tab}" GroupName="tab" IsChecked="True" Content="概览"/>
          <RadioButton x:Name="TabWarm" Style="{StaticResource Tab}" GroupName="tab" Content="预热启动"/>
          <RadioButton x:Name="TabTune" Style="{StaticResource Tab}" GroupName="tab" Content="系统优化"/>
          <RadioButton x:Name="TabAbout" Style="{StaticResource Tab}" GroupName="tab" Content="关于"/>
        </StackPanel>
      </Border>

      <!-- ===== 内容 ===== -->
      <Grid Grid.Row="2" Background="{DynamicResource B.SurfaceAlt}">
        <Grid Margin="24,20,24,18">

          <!-- 概览 -->
          <Grid x:Name="PageOverview">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Hero -->
            <Border Grid.Row="0" CornerRadius="18" Margin="0,0,0,12" Padding="22,16"
                    Background="{DynamicResource B.AccentGrad}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock x:Name="HeroKicker" Text="游戏盘" FontSize="11" Foreground="#CCFFFFFF"/>
                  <TextBlock x:Name="DiskName" Text="—" FontSize="21" FontWeight="Bold" Foreground="White"
                             Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="DiskSpec" Text="—" FontSize="11.5" Foreground="#D9FFFFFF" Margin="0,5,0,0"/>
                  <Grid Margin="0,10,0,0" Width="420" HorizontalAlignment="Left">
                    <Border Height="7" CornerRadius="3.5" Background="#33FFFFFF">
                      <Border x:Name="DiskBarFill" Height="7" CornerRadius="3.5" Background="White"
                              HorizontalAlignment="Left" Width="120"/>
                    </Border>
                  </Grid>
                  <TextBlock x:Name="DiskBarText" Text="" FontSize="11" Foreground="#D9FFFFFF" Margin="0,7,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                  <TextBlock Text="顺序读取" FontSize="11" Foreground="#CCFFFFFF" HorizontalAlignment="Right"/>
                  <TextBlock Text="120~160" FontSize="30" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Right" Margin="0,2,0,0"/>
                  <TextBlock Text="MB/s  ·  固态约 500" FontSize="10.5" Foreground="#CCFFFFFF" HorizontalAlignment="Right"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- 三个小卡 -->
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,12">
              <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="处理器" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="CpuName" Text="—" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Text}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CpuSpec" Text="—" FontSize="11" Foreground="{DynamicResource B.TextMute}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="显卡" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="GpuName" Text="—" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Text}" Margin="0,7,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="GpuSpec" Text="—" FontSize="11" Foreground="{DynamicResource B.TextMute}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                  <TextBlock Text="内存" Style="{StaticResource Label}"/>
                  <TextBlock x:Name="MemName" Text="—" FontSize="13.5" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Text}" Margin="0,7,0,0"/>
                  <TextBlock x:Name="MemSpec" Text="—" FontSize="11" Foreground="{DynamicResource B.TextMute}" Margin="0,4,0,0"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <!-- 磁盘速度对比 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="16,12">
              <StackPanel>
                <Grid Margin="0,0,0,9">
                  <TextBlock Text="磁盘速度对比" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock Text="顺序读写" FontSize="11" Foreground="{DynamicResource B.TextMute}" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,7">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="机械盘（典型）" FontSize="11.5" Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="120~160 MB/s" FontSize="11.5" Foreground="{DynamicResource B.Warn}" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Width="320" Height="8" CornerRadius="4"
                          Background="{DynamicResource B.SurfaceAlt}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="96" Height="8" CornerRadius="4" HorizontalAlignment="Left" Background="#F79009"/>
                  </Border>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="124"/>
                    <ColumnDefinition Width="112"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="SATA 固态（参考）" FontSize="11.5" Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="≈500 MB/s" FontSize="11.5" Foreground="{DynamicResource B.Ok}" VerticalAlignment="Center"/>
                  <Border Grid.Column="2" Width="320" Height="8" CornerRadius="4"
                          Background="{DynamicResource B.SurfaceAlt}" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Border Width="320" Height="8" CornerRadius="4" HorizontalAlignment="Left" Background="#12B76A"/>
                  </Border>
                </Grid>
              </StackPanel>
            </Border>

            <!-- 状态 + 快捷 -->
            <Grid Grid.Row="3">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="20,16">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="系统状态" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                      <TextBlock x:Name="PageSub" Text="正在读取…" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button x:Name="BtnRescan" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Padding="13,7" FontSize="11.5" Content="重新检测"/>
                  </Grid>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="StatusPanel"/>
                  </ScrollViewer>
                </Grid>
              </Border>

              <StackPanel Grid.Column="1">
                <Border Style="{StaticResource Card}" Padding="20,16">
                  <StackPanel>
                    <TextBlock Text="快速开始" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="OvHint" Text="先做一次系统优化，再预热启动游戏。" Style="{StaticResource Sub}"
                               Margin="0,6,0,14" TextWrapping="Wrap" LineHeight="18"/>
                    <Button x:Name="BtnGoWarm" Style="{StaticResource BtnPrimary}" Content="预热并启动游戏"
                            HorizontalAlignment="Stretch"/>
                    <Button x:Name="BtnGoTune" Style="{StaticResource BtnGhost}" Content="系统优化"
                            HorizontalAlignment="Stretch" Margin="0,9,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- 预热启动 -->
          <Grid x:Name="PageWarm" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,2,0,14">
              <StackPanel>
                <TextBlock Text="预热启动" Style="{StaticResource H1}"/>
                <TextBlock Text="把游戏要读的数据先读进内存，启动时就不走机械盘了"
                           Style="{StaticResource Sub}" Margin="0,4,0,0"/>
              </StackPanel>
              <Button x:Name="BtnAddGame" Style="{StaticResource BtnGhost}" Content="+ 添加游戏"
                      HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="机械盘" FontSize="12" Foreground="{DynamicResource B.TextDim}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel x:Name="DiskPanel" Orientation="Horizontal"/>
              </StackPanel>
              <TextBlock x:Name="DiskCountText" Text="" FontSize="11.5"
                         Foreground="{DynamicResource B.TextMute}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,14">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="缓存预算" FontSize="12" Foreground="{DynamicResource B.TextDim}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <RadioButton x:Name="Seg1" Style="{StaticResource Seg}" GroupName="budget" Content="1 GB"/>
                <RadioButton x:Name="Seg2" Style="{StaticResource Seg}" GroupName="budget" Content="2 GB" IsChecked="True"/>
                <RadioButton x:Name="Seg3" Style="{StaticResource Seg}" GroupName="budget" Content="3 GB"/>
                <RadioButton x:Name="Seg4" Style="{StaticResource Seg}" GroupName="budget" Content="4 GB"/>
              </StackPanel>
              <TextBlock x:Name="BudgetHint" Text="约 21 秒" FontSize="11.5"
                         Foreground="{DynamicResource B.TextMute}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="GamesPanel"/>
              </ScrollViewer>
            </Border>

            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,15">
              <StackPanel>
                <Grid Margin="0,0,0,10">
                  <TextBlock x:Name="WarmStatus" Text="选择上面的游戏开始" FontSize="12"
                             Foreground="{DynamicResource B.TextDim}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="WarmPct" Text="" FontSize="12" Foreground="{DynamicResource B.Accent}"
                             HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="WarmBar" Style="{StaticResource PBar}" Value="0" Maximum="100"/>
              </StackPanel>
            </Border>
          </Grid>

          <!-- 系统优化 -->
          <Grid x:Name="PageTune" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,2,0,14">
              <TextBlock Text="系统优化" Style="{StaticResource H1}"/>
              <TextBlock Text="勾选要做的项目，每项都可还原" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
              </Grid.ColumnDefinitions>

              <Border Style="{StaticResource Card}" Margin="0,0,16,0" Padding="10">
                <StackPanel x:Name="TunePanel" Margin="4,2"/>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="执行日志" FontSize="13" FontWeight="SemiBold"
                             Foreground="{DynamicResource B.Text}" Margin="0,0,0,10"/>
                  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="LogText" Text="" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                               TextWrapping="Wrap" LineHeight="20"/>
                  </ScrollViewer>
                </Grid>
              </Border>
            </Grid>

            <Grid Grid.Row="2" Margin="0,14,0,0">
              <TextBlock x:Name="TuneStatus" Text="" FontSize="11.5" Foreground="{DynamicResource B.TextMute}"
                         VerticalAlignment="Center"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnUndo" Style="{StaticResource BtnGhost}" Content="还原改动" Margin="0,0,10,0"/>
                <Button x:Name="BtnRun" Style="{StaticResource BtnPrimary}" Content="开始优化"/>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- 关于 -->
          <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="24,22">
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <Border Width="56" Height="56" CornerRadius="16" Background="{DynamicResource B.AccentGrad}">
                      <Viewbox Margin="14">
                        <Path Fill="White" Data="M13,1 L4,14 L11,14 L10,23 L20,9 L13,9 Z"/>
                      </Viewbox>
                    </Border>
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="Warmspin" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource B.Text}"/>
                      <TextBlock x:Name="AboutVersion" Text="版本 2.0.0" FontSize="12"
                                 Foreground="{DynamicResource B.TextDim}" Margin="0,3,0,0"/>
                      <TextBlock x:Name="AboutAuthor" Text="作者 Kite" FontSize="12"
                                 Foreground="{DynamicResource B.TextDim}" Margin="0,2,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="开源 · MIT" FontSize="11.5" Foreground="{DynamicResource B.TextMute}"
                               HorizontalAlignment="Right"/>
                    <TextBlock Text="Windows 10 / 11" FontSize="11" Foreground="{DynamicResource B.TextMute}"
                               HorizontalAlignment="Right" Margin="0,3,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="检查更新" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="UpdateStatus" Text="点击右侧按钮检查是否有新版本"
                               Style="{StaticResource Sub}" Margin="0,5,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button x:Name="BtnCheckUpdate" Style="{StaticResource BtnGhost}" Content="检查更新"
                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="放到桌面" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                    <TextBlock x:Name="DeskHint" Text="在桌面生成 Warmspin 快捷方式"
                               Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <Button x:Name="BtnDesktop" Style="{StaticResource BtnGhost}" Content="生成"
                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <Grid>
                  <StackPanel>
                    <TextBlock Text="还原所有优化" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                    <TextBlock Text="撤销 SysMain / 预读 / 杀软排除 / 索引 / 休眠 的改动"
                               Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                  </StackPanel>
                  <Button x:Name="BtnUndo2" Style="{StaticResource BtnGhost}" Content="还原"
                          HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="使用步骤" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock Margin="0,9,0,0" FontSize="11.5" Foreground="{DynamicResource B.TextDim}"
                             TextWrapping="Wrap" LineHeight="22"
                             Text="1.  概览：看系统状态。绿点是正常，黄/红点建议先做一次优化。&#x0a;2.  系统优化：勾选想做的项，点「开始优化」。碎片整理最慢，建议单独跑。&#x0a;3.  预热启动：选机械盘 → 选缓存预算 → 点游戏右边的「预热启动」。&#x0a;4.  关于：生成桌面快捷方式、检查更新、一键还原。"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                  <TextBlock Text="常见问题" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock Margin="0,9,0,0" FontSize="11.5" Foreground="{DynamicResource B.TextMute}"
                             TextWrapping="Wrap" LineHeight="22"
                             Text="·  找不到游戏？点「+ 添加游戏」手动选安装目录，之后会一直记住。&#x0a;·  预热要多久？按机械盘 95 MB/s 算，2 GB 约 21 秒、4 GB 约 43 秒。&#x0a;·  预热有用吗？同一张图第二次进会明显更快，因为数据已经在内核缓存里。&#x0a;·  改坏了怎么办？系统优化页右下角「还原改动」逐项恢复。"/>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="关于这个工具" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource B.Text}"/>
                  <TextBlock Margin="0,9,0,0" FontSize="11.5" Foreground="{DynamicResource B.TextMute}"
                             TextWrapping="Wrap" LineHeight="21"
                             Text="Warmspin 给装在机械硬盘上的游戏做加载优化：修预读、杀软扫描、索引、碎片，并把要读的数据提前读进内存。&#x0a;它不能让机械盘达到固态盘的速度——那是物理限制。想真正接近，请把游戏装到 SSD 上。&#x0a;MIT 协议开源，作者 Kite。"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- 主题浮层 -->
      <Popup x:Name="ThemePopup" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PlacementTarget="{Binding ElementName=BtnTheme}">
        <Border Background="{DynamicResource B.Surface}" BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                CornerRadius="12" Padding="8" Margin="0,6,0,0">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.18" Color="#000000"/>
          </Border.Effect>
          <StackPanel>
            <Button x:Name="BtnThemeNight" Style="{StaticResource BtnGhost}" Tag="redblack" BorderThickness="0" Padding="12,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="7" Background="#0E1014" VerticalAlignment="Center"/>
                <TextBlock Text="红黑 · 默认" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnThemeRed" Style="{StaticResource BtnGhost}" Tag="red" BorderThickness="0" Padding="12,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="7" Background="#E4393C" VerticalAlignment="Center"/>
                <TextBlock Text="红白 · 浅色" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnThemeBlue" Style="{StaticResource BtnGhost}" Tag="blue" BorderThickness="0" Padding="12,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="7" Background="#2563EB" VerticalAlignment="Center"/>
                <TextBlock Text="靛蓝 · 冷静" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnThemeGreen" Style="{StaticResource BtnGhost}" Tag="green" BorderThickness="0" Padding="12,9">
              <StackPanel Orientation="Horizontal">
                <Border Width="14" Height="14" CornerRadius="7" Background="#0E9F6E" VerticalAlignment="Center"/>
                <TextBlock Text="青竹 · 清爽" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>

          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
